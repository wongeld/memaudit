{
  "mcpServers": {
    "openstreetmap": {
      "command": "uv",
      "args": [
        "run",
        "--project",

        ".",
        "python",
        ".pi/openstreetmap_mcp.py",
        "--keep-alive"
      ],
      "enabled": true,
      "exposure": "direct",
      "env": {
        "NOMINATIM_URL": "http://localhost:8080"
      }
    }
  }
}
